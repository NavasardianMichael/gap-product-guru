// =============================================================================
// Gap Product Guru — database schema
//
// Vectors live in `chunks.embedding` (pgvector). Prisma has no vector type, so the
// column is declared Unsupported and read/written with raw SQL in
// src/repositories/chunkRepository.ts. The `vector` extension is created by the
// init migration. See docs/DATABASE.md.
// =============================================================================

generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

// =============================================================================
// ENUMS
// =============================================================================

enum MessageRole {
  user
  assistant
}

enum FeedbackRating {
  helpful
  incorrect
}

// =============================================================================
// MODELS
// =============================================================================

/// One Markdown file from DOCS_DIR.
model Document {
  id          String   @id @default(uuid())
  /// Path relative to DOCS_DIR, always with forward slashes
  path        String   @unique
  title       String
  /// Top-level wiki section: the first path segment without `.md` (src/lib/docAreas.ts)
  area        String   @default("")
  /// sha256 of CHUNKER_VERSION + embedding model + file content — any change re-chunks the file
  contentHash String   @map("content_hash")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  // Relations
  chunks Chunk[]

  @@index([area])
  @@map("documents")
}

/// A heading-aware slice of a Document (~500 tokens) plus its embedding.
model Chunk {
  id         String                     @id @default(uuid())
  documentId String                     @map("document_id")
  position   Int
  /// Heading breadcrumb, e.g. "Setup › Windows"
  heading    String
  content    String
  tokenCount Int                        @map("token_count")
  /// NULL until `pnpm ingest` embeds it — that is what makes ingestion resumable.
  /// 768 must match EMBEDDING_DIMENSIONS in src/lib/gemini.ts.
  embedding  Unsupported("vector(768)")?
  createdAt  DateTime                   @default(now()) @map("created_at")

  // Relations
  document Document @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@unique([documentId, position])
  @@map("chunks")
}

model Conversation {
  id        String   @id @default(uuid())
  /// Anonymous per-browser id from the X-Client-Id header — scoping, not authentication
  clientId  String   @map("client_id")
  title     String
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Relations
  messages Message[]

  @@index([clientId, updatedAt])
  @@map("conversations")
}

model Message {
  id             String      @id @default(uuid())
  conversationId String      @map("conversation_id")
  role           MessageRole
  content        String
  /// ChatSource[] (shared/src/types/chat.ts) for assistant messages
  sources        Json?
  /// The quoted part of an earlier answer this question replies to (user messages only)
  replyTo        String?     @map("reply_to")
  /// The assistant message `replyTo` was quoted from — a plain id (no FK), used to scroll back to it
  replyToId      String?     @map("reply_to_id")
  createdAt      DateTime    @default(now()) @map("created_at")

  // Relations
  conversation Conversation      @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  feedback     MessageFeedback[]

  @@index([conversationId, createdAt])
  @@map("messages")
}

/// One browser's verdict on one answer: "helped", or a report of misleading/incorrect info.
/// The question, answer and sources are copied in, so a report survives its conversation being deleted.
model MessageFeedback {
  id         String         @id @default(uuid())
  /// NULL once the conversation is deleted — the copied fields below keep the report readable
  messageId  String?        @map("message_id")
  clientId   String         @map("client_id")
  rating     FeedbackRating
  /// What the reporter says is wrong (reports only)
  note       String?
  question   String
  answer     String
  /// ChatSource[] of the answer
  sources    Json
  /// Set when an admin has handled the report
  resolvedAt DateTime?      @map("resolved_at")
  createdAt  DateTime       @default(now()) @map("created_at")
  updatedAt  DateTime       @updatedAt @map("updated_at")

  // Relations
  message Message? @relation(fields: [messageId], references: [id], onDelete: SetNull)

  @@unique([messageId, clientId])
  @@index([rating, resolvedAt, createdAt])
  @@map("message_feedback")
}

/// A read-only snapshot of a conversation, opened by anyone with its link (/share/:id).
model SharedConversation {
  id             String   @id @default(uuid())
  /// The browser that created the link
  clientId       String   @map("client_id")
  /// The conversation it was taken from — a plain id, so the snapshot outlives the conversation
  conversationId String   @map("conversation_id")
  title          String
  /// SharedMessage[] (src/services/shareService.ts) as they were when the link was created
  messages       Json
  createdAt      DateTime @default(now()) @map("created_at")

  @@map("shared_conversations")
}
