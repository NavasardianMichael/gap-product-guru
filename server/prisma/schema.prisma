// =============================================================================
// Gap Product Guru — database schema
//
// Vectors live in `chunks.embedding` (pgvector). Prisma has no vector type, so the
// column is declared Unsupported and read/written with raw SQL in
// src/repositories/chunkRepository.ts. The `vector` extension is created by the
// init migration. See docs/DATABASE.md.
// =============================================================================

generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

// =============================================================================
// ENUMS
// =============================================================================

enum MessageRole {
  user
  assistant
}

// =============================================================================
// MODELS
// =============================================================================

/// One Markdown file from DOCS_DIR.
model Document {
  id          String   @id @default(uuid())
  /// Path relative to DOCS_DIR, always with forward slashes
  path        String   @unique
  title       String
  /// sha256 of CHUNKER_VERSION + embedding model + file content — any change re-chunks the file
  contentHash String   @map("content_hash")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  // Relations
  chunks Chunk[]

  @@map("documents")
}

/// A heading-aware slice of a Document (~500 tokens) plus its embedding.
model Chunk {
  id         String                     @id @default(uuid())
  documentId String                     @map("document_id")
  position   Int
  /// Heading breadcrumb, e.g. "Setup › Windows"
  heading    String
  content    String
  tokenCount Int                        @map("token_count")
  /// NULL until `pnpm ingest` embeds it — that is what makes ingestion resumable.
  /// 768 must match EMBEDDING_DIMENSIONS in src/lib/gemini.ts.
  embedding  Unsupported("vector(768)")?
  createdAt  DateTime                   @default(now()) @map("created_at")

  // Relations
  document Document @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@unique([documentId, position])
  @@map("chunks")
}

model Conversation {
  id        String   @id @default(uuid())
  /// Anonymous per-browser id from the X-Client-Id header — scoping, not authentication
  clientId  String   @map("client_id")
  title     String
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Relations
  messages Message[]

  @@index([clientId, updatedAt])
  @@map("conversations")
}

model Message {
  id             String      @id @default(uuid())
  conversationId String      @map("conversation_id")
  role           MessageRole
  content        String
  /// ChatSource[] (shared/src/types/chat.ts) for assistant messages
  sources        Json?
  createdAt      DateTime    @default(now()) @map("created_at")

  // Relations
  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
  @@map("messages")
}
