# Copy to .env.development.local (dev, `pnpm dev` / `pnpm ingest`).
# Production: fill server/.env.production.local with the keys of this file, then
# `pnpm env:base64 production | clip` → GitHub secret ENV_SERVER_BASE64 (docs/DEPLOYMENT.md).
# NODE_ENV, PORT, HOST and DOCS_DIR are set by the deploy — leave them out of the production file.

# Application
NODE_ENV=development
PORT=9005
# HOST=127.0.0.1   # production: listen on loopback only, behind nginx (set by the deploy)
LOG_LEVEL=debug

# PostgreSQL (matches docker-compose.yml defaults)
DATABASE_URL=postgresql://guru:guru@localhost:5435/gap_product_guru

# Google Gemini — free key from https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_CHAT_MODEL=gemini-3.8-flash
GEMINI_EMBEDDING_MODEL=gemini-embedding-2

# Shown to the model in the system prompt ("…answers questions about <PRODUCT_NAME>")
PRODUCT_NAME=the product

# Retrieval
RAG_TOP_K=8
CHAT_HISTORY_TURNS=3

# Ingestion (DOCS_DIR is resolved from the server/ folder)
DOCS_DIR=../data/docs
EMBED_BATCH_SIZE=50

# Docs source for `pnpm docs:pull` / `pnpm docs:sync` — cloned into DOCS_DIR.
# Auth comes from your git credential manager; never put a token in the URL.
# wikiMaster is the branch of every Azure DevOps project wiki (empty = the remote's default).
DOCS_REPO_URL=https://GAP-Default@dev.azure.com/GAP-Default/GAP%20International/_git/GAP-International.wiki
DOCS_REPO_BRANCH=wikiMaster
# Servers only: an Azure DevOps PAT with Code (Read) scope, sent as an HTTP auth header.
# Leave empty on your machine — the git credential manager signs you in there.
DOCS_REPO_TOKEN=

# The same wiki in the browser — answer sources link to its pages (empty = sources are plain text)
DOCS_WEB_URL=https://dev.azure.com/GAP-Default/GAP%20International/_wiki/wikis/GAP-International.wiki

# Our own limit on POST /api/chat, per IP, to protect the shared free Gemini quota
CHAT_RATE_LIMIT_PER_MINUTE=10
