{
  "permissions": {
    "deny": [
      "Read(**/.env)",
      "Read(**/.env.local)",
      "Read(**/.env.*.local)",
      "Grep(**/.env)",
      "Grep(**/.env.local)",
      "Grep(**/.env.*.local)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell|Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/guardDocsRepo.mjs\"",
            "timeout": 10,
            "onFailure": "block",
            "statusMessage": "Checking docs repo guard"
          }
        ]
      },
      {
        "matcher": "Read|Edit|Write|MultiEdit|NotebookEdit|Grep|Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/guardEnvFiles.mjs\"",
            "timeout": 10,
            "onFailure": "block",
            "statusMessage": "Checking env file guard"
          }
        ]
      }
    ]
  }
}
