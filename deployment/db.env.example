# Postgres container configuration — NOT app configuration.
#
# The shape of $APP_DIR/db/.env on the server, beside docker-compose.prod.yml. You do not
# write it: the first deploy does (ensure_database in deploy.yml), deriving all three values
# from DATABASE_URL so the two cannot disagree, and never rewrites an existing one.
#
#   DATABASE_URL="postgresql://guru:<password>@127.0.0.1:5008/gap_product_guru"
#                             ^^^^ ^^^^^^^^^^                  ^^^^^^^^^^^^^^^^
#                    POSTGRES_USER  POSTGRES_PASSWORD           POSTGRES_DB
#
# 127.0.0.1, never `localhost` (it can resolve to ::1, where nothing listens). 5008 is the
# HOST port the container publishes; inside it Postgres is on 5432.
#
# ⚠ POSTGRES_PASSWORD is only read on FIRST start, when the volume is initialised. To rotate:
#   docker exec -it gap-product-guru-postgres-prod psql -U guru -d gap_product_guru \
#     -c "ALTER USER guru WITH PASSWORD 'new';"
# then update DATABASE_URL (ENV_SERVER_BASE64) and redeploy.

POSTGRES_USER=guru
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Hex on purpose — nothing that needs percent-encoding inside DATABASE_URL.
POSTGRES_PASSWORD=
POSTGRES_DB=gap_product_guru
